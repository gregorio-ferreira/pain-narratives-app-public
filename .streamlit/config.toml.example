[server]
# Server configuration
port = 8501
address = "localhost"
baseUrlPath = ""
enableCORS = true
enableXsrfProtection = true

# Static file serving is unnecessary for the app
enableStaticServing = false

# WebSocket configuration
maxUploadSize = 5
maxMessageSize = 200

# Performance
runOnSave = false
allowRunOnSave = false

[browser]
# Prevent automatic opening
gatherUsageStats = false
serverAddress = "YOUR_DEPLOYMENT_HOSTNAME.example.com"
serverPort = 80

[client]
# Client configuration
showErrorDetails = "none"
toolbarMode = "minimal"

[theme]
# Default theme
primaryColor = "#FF4B4B"
backgroundColor = "#FFFFFF"
secondaryBackgroundColor = "#F0F2F6"
textColor = "#262730"
font = "sans serif"
